# ==============================================================================
# Tuy chon: HTTPS tu dong (Let's Encrypt) khi ban da tro domain ve IP EC2.
#
# Cach dung:
#   1. Cai cert-manager:
#        kubectl apply -f https://github.com/cert-manager/cert-manager/releases/download/v1.16.2/cert-manager.yaml
#        kubectl -n cert-manager rollout status deploy/cert-manager-webhook
#   2. Copy file nay thanh 11-ingress-tls.yaml (da nam trong .gitignore),
#      thay YOUR_EMAIL va YOUR_DOMAIN (vd: backhaulbid.yourdomain.com).
#   3. Apply:
#        kubectl apply -f k3s/11-ingress-tls.yaml
#   4. Cap nhat .env.k3s:
#        PUBLIC_BASE_URL=https://YOUR_DOMAIN
#        INGRESS_HOST=YOUR_DOMAIN
#        COOKIE_SECURE=true
#      Sau do build lai web-portal (de nhung NEXT_PUBLIC_GATEWAY_URL=https://YOUR_DOMAIN)
#      va chay lai ./k3s/scripts/deploy.sh.
# ==============================================================================
apiVersion: cert-manager.io/v1
kind: ClusterIssuer
metadata:
  name: letsencrypt-prod
spec:
  acme:
    email: YOUR_EMAIL
    server: https://acme-v02.api.letsencrypt.org/directory
    privateKeySecretRef:
      name: letsencrypt-prod-account-key
    solvers:
      - http01:
          ingress:
            class: traefik
---
apiVersion: traefik.io/v1alpha1
kind: Middleware
metadata:
  name: redirect-https
  namespace: backhaulbid
spec:
  redirectScheme:
    scheme: https
    permanent: true
---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: backhaulbid-ingress
  namespace: backhaulbid
  annotations:
    cert-manager.io/cluster-issuer: letsencrypt-prod
    traefik.ingress.kubernetes.io/router.entrypoints: web,websecure
    traefik.ingress.kubernetes.io/router.middlewares: backhaulbid-redirect-https@kubernetescrd
spec:
  ingressClassName: traefik
  tls:
    - hosts:
        - YOUR_DOMAIN
      secretName: backhaulbid-tls-cert
  rules:
    - host: YOUR_DOMAIN
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: api-gateway
                port:
                  number: 8080
