# ==============================================================================
# BackHaulBid - K3s on AWS EC2 Environment Configuration Template
# ==============================================================================
# Cách dùng:
#   cp k3s/.env.k3s.example k3s/.env.k3s
#   chmod 600 k3s/.env.k3s
#   nano k3s/.env.k3s   # Điền đầy đủ các biến BẮT BUỘC bên dưới
#
# LƯU Ý BẢO MẬT:
#   - KHÔNG BAO GIỜ commit file .env.k3s lên Git (.gitignore đã chặn sẵn).
#   - Password DB/Redis/RabbitMQ nên dùng ký tự chữ + số (sinh bằng: openssl rand -hex 24)
#     để tránh lỗi URL-encoding trong MONGO_URI / REDIS_URL / RABBITMQ_URL.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PUBLIC URL & MODE TRUY CẬP (BẮT BUỘC)
# ------------------------------------------------------------------------------
# Nếu chưa có domain: dùng http://<EC2_PUBLIC_IP>  và đặt COOKIE_SECURE=false
# Nếu đã có domain + HTTPS: dùng https://api.yourdomain.com (hoặc https://yourdomain.com)
#                           và đặt COOKIE_SECURE=true
PUBLIC_BASE_URL=http://<EC2_PUBLIC_IP>
# Bỏ trống nếu truy cập bằng IP trực tiếp; điền domain (vd: backhaulbid.vn) nếu đã trỏ DNS
INGRESS_HOST=
# false khi chạy HTTP (IP EC2), true khi chạy HTTPS (có domain + TLS)
COOKIE_SECURE=false

# ------------------------------------------------------------------------------
# 2. CONTAINER IMAGE (BẮT BUỘC KHI DEPLOY)
# ------------------------------------------------------------------------------
# Chế độ build trực tiếp trên EC2 & import vào K3s: giữ nguyên IMAGE_REGISTRY=backhaulbid
# Chế độ pull từ Registry (GHCR/DockerHub/ECR): vd ghcr.io/phucvinh0411
IMAGE_REGISTRY=backhaulbid
IMAGE_TAG=v1

# ------------------------------------------------------------------------------
# 3. DATABASE, REDIS & RABBITMQ SECRETS (BẮT BUỘC - ĐỔI TOÀN BỘ)
# ------------------------------------------------------------------------------
POSTGRES_USER=backhaulbid
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD

MONGO_USER=backhaulbid
MONGO_PASSWORD=CHANGE_ME_MONGO_PASSWORD

REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

RABBITMQ_USER=backhaulbid
RABBITMQ_PASSWORD=CHANGE_ME_RABBITMQ_PASSWORD

# ------------------------------------------------------------------------------
# 4. BẢO MẬT ỨNG DỤNG & INTERNAL TOKENS (BẮT BUỘC - ĐỔI TOÀN BỘ)
# ------------------------------------------------------------------------------
# Khóa ký JWT dạng Base64 >= 32 bytes (api-gateway & identity-service giải mã Base64, sinh bằng: openssl rand -base64 48)
JWT_SECRET=CHANGE_ME_BASE64_JWT_SECRET_AT_LEAST_32_BYTES

# Token giao tiếp nội bộ giữa các microservices (sinh bằng: openssl rand -hex 32)
INTERNAL_SERVICE_TOKEN=CHANGE_ME_INTERNAL_SERVICE_TOKEN
INTERNAL_WALLET_TOKEN=CHANGE_ME_INTERNAL_WALLET_TOKEN

# V3.1 Driver code sign-in: AES-256-GCM key (đúng 32 bytes base64: openssl rand -base64 32)
DRIVER_REPLAY_KEY=CHANGE_ME_BASE64_32_BYTES

# ------------------------------------------------------------------------------
# 5. AWS S3 MEDIA STORAGE (BẮT BUỘC để upload ảnh/chứng từ qua media-service)
# ------------------------------------------------------------------------------
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=backhaulbid-s3
AWS_ACCESS_KEY_ID=CHANGE_ME_AWS_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=CHANGE_ME_AWS_SECRET_KEY

# ------------------------------------------------------------------------------
# 6. CORS & API GATEWAY (TÙY CHỈNH NẾU CÓ EXPO / DOMAIN PHỤ)
# ------------------------------------------------------------------------------
# Mặc định deploy.sh sẽ tự gán FRONTEND_ORIGIN = PUBLIC_BASE_URL nếu để trống
FRONTEND_ORIGIN=
FRONTEND_LAN_ORIGIN=http://localhost:3000
EXPO_WEB_ORIGIN=http://localhost:3002
EXPO_LAN_ORIGIN=http://localhost:3002

# Bật Swagger UI (/swagger-ui.html) - khuyến nghị false trên môi trường public
SWAGGER_ENABLED=false

# Đường dẫn Socket.IO đấu giá (giữ mặc định)
NEXT_PUBLIC_BIDDING_SOCKET_PATH=/bidding-socket

# Flyway locations cho identity-service:
# - Production/Staging chuẩn: classpath:db/migration
# - Muốn tự seed tài khoản dev-migration: classpath:db/migration,classpath:db/dev-migration
IDENTITY_FLYWAY_LOCATIONS=classpath:db/migration

# ------------------------------------------------------------------------------
# 7. EMAIL OTP KÝ HỢP ĐỒNG - SMTP (BẮT BUỘC NẾU BẬT CONTRACT_OTP_MAIL_ENABLED=true)
# ------------------------------------------------------------------------------
CONTRACT_OTP_MAIL_ENABLED=true
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@backhaulbid.vn
MAIL_FROM_NAME=BackhaulBid
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true

# ------------------------------------------------------------------------------
# 8. THANH TOÁN SEPAY (TÙY CHỌN - mặc định false)
# ------------------------------------------------------------------------------
SEPAY_ENABLED=false
SEPAY_MERCHANT_ID=
SEPAY_SECRET_KEY=
SEPAY_IPN_SECRET=
SEPAY_CHECKOUT_URL=https://pay-sandbox.sepay.vn/v1/checkout/init
# Nếu để trống, deploy.sh sẽ tự ghép theo PUBLIC_BASE_URL/carrier/wallet?payment=...
SEPAY_SUCCESS_URL=
SEPAY_ERROR_URL=
SEPAY_CANCEL_URL=

# ------------------------------------------------------------------------------
# 9. TÍCH HỢP NGOÀI TÙY CHỌN (Google Sign-In, NFC eKYC, Tra cứu MST, OSRM)
# ------------------------------------------------------------------------------
# Google OAuth 2.0 Web Client ID (bỏ trống nếu chưa dùng đăng nhập Google)
GOOGLE_CLIENT_ID=

# NFC eKYC (nếu bật true, bắt buộc cung cấp EKYC_EVIDENCE_ENCRYPTION_KEY: openssl rand -base64 32)
NFC_EKYC_ENABLED=false
EKYC_EVIDENCE_ENCRYPTION_KEY=
# DISABLED (chuyển admin duyệt) hoặc COMPLETED_ONLY (tự duyệt khi app pass hết)
EKYC_AUTO_ACCEPT=DISABLED

# Tra cứu mã số thuế doanh nghiệp (xinvoice.vn)
BUSINESS_LOOKUP_CLIENT_ID=
BUSINESS_LOOKUP_API_KEY=

# OSRM Routing vẽ đường đi A -> B trên bản đồ
ROUTING_BASE_URL=https://router.project-osrm.org
