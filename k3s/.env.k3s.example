# ==============================================================================
# BackHaulBid - K3s on AWS EC2 Environment Configuration Template
# ==============================================================================
# Cách dùng:
#   cp k3s/.env.k3s.example k3s/.env.k3s
#   chmod 600 k3s/.env.k3s
#   nano k3s/.env.k3s   # Điền đầy đủ các biến BẮT BUỘC bên dưới
#
# Kiến trúc K3s (Stateless App-Only + External Managed Databases):
#   - Trên K3s chỉ chạy 9 Application Pod + Traefik Ingress (không chạy Eureka,
#     không tự host PostgreSQL / MongoDB / Redis / RabbitMQ trong cụm).
#   - PostgreSQL + Valkey (Redis) -> Aiven (hoặc managed Postgres/Redis ngoài)
#   - MongoDB                     -> MongoDB Atlas (Aiven không hỗ trợ MongoDB)
#   - RabbitMQ                    -> CloudAMQP / Amazon MQ (Aiven không hỗ trợ RabbitMQ)
#
# LƯU Ý BẢO MẬT:
#   - KHÔNG BAO GIỜ commit file .env.k3s lên Git (.gitignore đã chặn sẵn).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PUBLIC URL & MODE TRUY CẬP (BẮT BUỘC)
# ------------------------------------------------------------------------------
# Nếu chưa có domain: dùng http://<EC2_PUBLIC_IP>  và đặt COOKIE_SECURE=false
# Nếu đã có domain + HTTPS: dùng https://api.yourdomain.com (hoặc https://yourdomain.com)
#                           và đặt COOKIE_SECURE=true
PUBLIC_BASE_URL=http://<EC2_PUBLIC_IP>
# Bỏ trống nếu truy cập bằng IP trực tiếp; điền domain (vd: backhaulbid.vn) nếu đã trỏ DNS
INGRESS_HOST=
# false khi chạy HTTP (IP EC2), true khi chạy HTTPS (có domain + TLS)
COOKIE_SECURE=false

# ------------------------------------------------------------------------------
# 2. CONTAINER IMAGE & DOCKER HUB (BẮT BUỘC KHI DEPLOY)
# ------------------------------------------------------------------------------
# Chế độ 1 - Push/Pull qua Docker Hub (khuyến nghị, build từ Windows/CI -> EC2 pull):
#   IMAGE_REGISTRY=<dockerhub_username_hoac_org>   # vd: hoangdev
#   IMAGE_PREFIX=backhaulbid-                     # -> hoangdev/backhaulbid-api-gateway:<tag>
#
# Chế độ 2 - Build trực tiếp trên EC2 & import vào K3s containerd:
#   IMAGE_REGISTRY=backhaulbid
#   IMAGE_PREFIX=
IMAGE_REGISTRY=backhaulbid
IMAGE_PREFIX=

# Tag version cho toàn bộ 9 service (vd: v1.0.0 hoặc Git short SHA như a1b2c3d).
# Đặt auto hoặc để trống để tự lấy `git rev-parse --short HEAD` (tránh dùng :latest gây lệch cache).
IMAGE_TAG=auto

# Kiến trúc CPU đích khi build Docker image (EC2 x86_64 dùng linux/amd64; Graviton dùng linux/arm64)
IMAGE_PLATFORM=linux/amd64

# Tùy chọn ImagePullPolicy: để trống = tự động (IfNotPresent với tag version; Always nếu tag latest/dev trên registry ngoài)
IMAGE_PULL_POLICY=

# Số replica cho toàn bộ 9 service (mặc định 2 cho High Availability trên EC2 >= 16 GB RAM; đặt 1 nếu máy 8 GB)
APP_REPLICAS=2

# Thông tin đăng nhập Docker Hub (tùy chọn):
#   - Cần DOCKERHUB_USERNAME + DOCKERHUB_TOKEN khi --push lên Docker Hub, HOẶC khi pull từ repo PRIVATE trên K3s.
#   - Nếu tất cả repo trên Docker Hub để PUBLIC và bạn đã `docker login` thủ công trên máy build, có thể để trống.
DOCKERHUB_USERNAME=
DOCKERHUB_TOKEN=
DOCKERHUB_SERVER=https://index.docker.io/v1/
IMAGE_PULL_SECRET_NAME=dockerhub-regcred

# ------------------------------------------------------------------------------
# 3. EXTERNAL MANAGED DATABASES & MESSAGE BROKER (BẮT BUỘC)
# ------------------------------------------------------------------------------
# 3A. Aiven for PostgreSQL (cần tạo 4 database: backhaulbid_identity,
#     backhaulbid_fleet, backhaulbid_wallet, backhaulbid_contract)
#   Cách nhanh (cùng 1 instance Aiven Postgres): điền HOST/PORT/USER/PASSWORD bên dưới,
#   deploy.sh sẽ tự ghép 4 JDBC URL với ?sslmode=${POSTGRES_SSLMODE}.
POSTGRES_HOST=CHANGE_ME_AIVEN_POSTGRES_HOST
POSTGRES_PORT=5432
POSTGRES_USER=avnadmin
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_SSLMODE=require
#   Hikari pool mỗi Pod cho 4 Postgres services: cả 4 đều chạy Flyway (identity/contract thêm PostgresAdvisoryLock)
#   nên đều cần tối thiểu = 2 max, min-idle = 1 -> với APP_REPLICAS=2 tổng max ước tính = (2*2 + 2*2)*2 = 16
#   (cần cẩn thận sát ngưỡng 15 của Aiven PostgreSQL Free; hoặc đặt APP_REPLICAS=1 -> max = 8). Nếu dùng RDS/gói cao hơn tăng 5..10.
DB_POOL_MAX_SIZE=2
DB_POOL_LIGHT_MAX_SIZE=2
DB_POOL_MIN_IDLE=1
#   Hoặc điền tường minh từng JDBC URL nếu dùng nhiều cụm/tên DB khác nhau (ưu tiên nếu không rỗng):
POSTGRES_IDENTITY_URL=
POSTGRES_FLEET_URL=
POSTGRES_WALLET_URL=
POSTGRES_CONTRACT_URL=

# 3B. MongoDB Atlas / External MongoDB (2 DB: bidding & notification)
#   Ví dụ: mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/backhaulbid_bidding?retryWrites=true&w=majority
MONGO_BIDDING_URI=CHANGE_ME_MONGO_BIDDING_URI
MONGO_NOTIFICATION_URI=CHANGE_ME_MONGO_NOTIFICATION_URI

# 3C. Aiven for Valkey / External Redis (copy Service URI từ Aiven Console)
#   Ví dụ: rediss://default:<pass>@valkey-xxxx.aivencloud.com:25061
#   (deploy.sh tự tách HOST/PORT/USERNAME/PASSWORD/SSL cho api-gateway và truyền nguyên REDIS_URL cho bidding-service)
REDIS_URL=CHANGE_ME_AIVEN_VALKEY_OR_REDIS_URI

# 3D. CloudAMQP / Amazon MQ / External RabbitMQ (copy AMQP URI)
#   Ví dụ CloudAMQP: amqps://<user>:<pass>@puffin.rmq2.cloudamqp.com/<vhost>
#   (deploy.sh tự tách HOST/PORT/USER/PASSWORD/VHOST/SSL cho contract-service và truyền nguyên RABBITMQ_URL cho Node services)
RABBITMQ_URL=CHANGE_ME_CLOUDAMQP_OR_RABBITMQ_URI

# ------------------------------------------------------------------------------
# 4. BẢO MẬT ỨNG DỤNG & INTERNAL TOKENS (BẮT BUỘC - ĐỔI TOÀN BỘ)
# ------------------------------------------------------------------------------
# Khóa ký JWT dạng Base64 >= 32 bytes (api-gateway & identity-service giải mã Base64, sinh bằng: openssl rand -base64 48)
JWT_SECRET=CHANGE_ME_BASE64_JWT_SECRET_AT_LEAST_32_BYTES

# Token giao tiếp nội bộ giữa các microservices (sinh bằng: openssl rand -hex 32)
INTERNAL_SERVICE_TOKEN=CHANGE_ME_INTERNAL_SERVICE_TOKEN
INTERNAL_WALLET_TOKEN=CHANGE_ME_INTERNAL_WALLET_TOKEN

# V3.1 Driver code sign-in: AES-256-GCM key (đúng 32 bytes base64: openssl rand -base64 32)
DRIVER_REPLAY_KEY=CHANGE_ME_BASE64_32_BYTES

# ------------------------------------------------------------------------------
# 5. AWS S3 MEDIA STORAGE (BẮT BUỘC để upload ảnh/chứng từ qua media-service)
# ------------------------------------------------------------------------------
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=backhaulbid-s3
AWS_ACCESS_KEY_ID=CHANGE_ME_AWS_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=CHANGE_ME_AWS_SECRET_KEY

# ------------------------------------------------------------------------------
# 6. CORS & API GATEWAY (TÙY CHỈNH NẾU CÓ EXPO / DOMAIN PHỤ)
# ------------------------------------------------------------------------------
# Mặc định deploy.sh sẽ tự gán FRONTEND_ORIGIN = PUBLIC_BASE_URL nếu để trống
FRONTEND_ORIGIN=
FRONTEND_LAN_ORIGIN=http://localhost:3000
EXPO_WEB_ORIGIN=http://localhost:3002
EXPO_LAN_ORIGIN=http://localhost:3002

# Bật Swagger UI (/swagger-ui.html) - khuyến nghị false trên môi trường public
SWAGGER_ENABLED=false

# Đường dẫn Socket.IO đấu giá (giữ mặc định)
NEXT_PUBLIC_BIDDING_SOCKET_PATH=/bidding-socket

# Flyway locations cho identity-service:
# - Production/Staging chuẩn: classpath:db/migration
# - Muốn tự seed tài khoản dev-migration: classpath:db/migration,classpath:db/dev-migration
IDENTITY_FLYWAY_LOCATIONS=classpath:db/migration

# ------------------------------------------------------------------------------
# 7. EMAIL OTP KÝ HỢP ĐỒNG - SMTP (BẮT BUỘC NẾU BẬT CONTRACT_OTP_MAIL_ENABLED=true)
# ------------------------------------------------------------------------------
CONTRACT_OTP_MAIL_ENABLED=true
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@backhaulbid.vn
MAIL_FROM_NAME=BackhaulBid
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true

# ------------------------------------------------------------------------------
# 8. THANH TOÁN SEPAY (TÙY CHỌN - mặc định false)
# ------------------------------------------------------------------------------
SEPAY_ENABLED=false
SEPAY_MERCHANT_ID=
SEPAY_SECRET_KEY=
SEPAY_IPN_SECRET=
SEPAY_CHECKOUT_URL=https://pay-sandbox.sepay.vn/v1/checkout/init
# Nếu để trống, deploy.sh sẽ tự ghép theo PUBLIC_BASE_URL/carrier/wallet?payment=...
SEPAY_SUCCESS_URL=
SEPAY_ERROR_URL=
SEPAY_CANCEL_URL=

# ------------------------------------------------------------------------------
# 9. TÍCH HỢP NGOÀI TÙY CHỌN (Google Sign-In, NFC eKYC, Tra cứu MST, OSRM)
# ------------------------------------------------------------------------------
# Google OAuth 2.0 Web Client ID (bỏ trống nếu chưa dùng đăng nhập Google)
GOOGLE_CLIENT_ID=

# NFC eKYC (nếu bật true, bắt buộc cung cấp EKYC_EVIDENCE_ENCRYPTION_KEY: openssl rand -base64 32)
NFC_EKYC_ENABLED=false
EKYC_EVIDENCE_ENCRYPTION_KEY=
# COMPLETED_ONLY (tự duyệt khi app pass hết checks) hoặc DISABLED (từ chối tự động)
EKYC_AUTO_ACCEPT=COMPLETED_ONLY

# Tra cứu mã số thuế doanh nghiệp (xinvoice.vn)
BUSINESS_LOOKUP_CLIENT_ID=
BUSINESS_LOOKUP_API_KEY=

# OSRM Routing vẽ đường đi A -> B trên bản đồ
ROUTING_BASE_URL=https://router.project-osrm.org
