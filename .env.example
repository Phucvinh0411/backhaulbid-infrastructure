# Local Docker Compose configuration.
# Copy this file to .env and replace the change-me values.

POSTGRES_USER=backhaulbid
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=backhaulbid_identity
POSTGRES_HOST_PORT=5432
POSTGRES_IDENTITY_URL=jdbc:postgresql://postgres:5432/backhaulbid_identity
POSTGRES_FLEET_URL=jdbc:postgresql://postgres:5432/backhaulbid_fleet
POSTGRES_WALLET_URL=jdbc:postgresql://postgres:5432/backhaulbid_wallet
POSTGRES_CONTRACT_URL=jdbc:postgresql://postgres:5432/backhaulbid_contract

MONGO_USER=backhaulbid
MONGO_PASSWORD=change-me-mongodb-password
MONGO_HOST_PORT=27017
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_BIDDING_DATABASE=backhaulbid_bidding

REDIS_PASSWORD=change-me-redis-password
REDIS_HOST_PORT=6379
REDIS_HOST=redis
REDIS_PORT=6379

RABBITMQ_USER=backhaulbid
RABBITMQ_PASSWORD=change-me-rabbitmq-password
RABBITMQ_HOST_PORT=5672
RABBITMQ_MANAGEMENT_HOST_PORT=15672
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672

EUREKA_HOST_PORT=8761
EUREKA_URL=http://eureka-server:8761/eureka/
API_GATEWAY_HOST_PORT=8080
WEB_HOST_PORT=3000
FRONTEND_ORIGIN=http://localhost:3000
WALLET_SERVICE_URL=http://wallet-service:8080
INTERNAL_GATEWAY_URL=http://api-gateway:8080
NEXT_PUBLIC_GATEWAY_URL=http://localhost:8080
NEXT_PUBLIC_BIDDING_SOCKET_PATH=/bidding-socket
NEXT_PUBLIC_VNPT_EKYC_BACKEND_URL=https://api.idg.vnpt.vn
NEXT_PUBLIC_VNPT_EKYC_TOKEN_KEY=
NEXT_PUBLIC_VNPT_EKYC_TOKEN_ID=
NEXT_PUBLIC_VNPT_EKYC_AUTH=

JWT_SECRET=change-me-long-random-jwt-secret
INTERNAL_WALLET_TOKEN=change-me-internal-wallet-token
SWAGGER_ENABLED=true
OPENAPI_GATEWAY_SERVER_URL=/api/v1/bidding
OPENAPI_DIRECT_SERVER_URL=http://localhost:3001

# AWS S3 media storage. Media-service is the only file upload boundary.
AWS_REGION=ap-southeast-2
AWS_S3_BUCKET=backhaulbid-s3
AWS_ACCESS_KEY_ID=change-me-aws-access-key
AWS_SECRET_ACCESS_KEY=change-me-aws-secret-key

# SePay Sandbox. Keep disabled until merchant credentials are available.
SEPAY_ENABLED=false
SEPAY_MERCHANT_ID=your-sandbox-merchant-id
SEPAY_SECRET_KEY=your-sandbox-secret-key
SEPAY_IPN_URL=
SEPAY_CHECKOUT_URL=https://pay-sandbox.sepay.vn/v1/checkout/init
SEPAY_SUCCESS_URL=http://localhost:8080/carrier/wallet?payment=success
SEPAY_ERROR_URL=http://localhost:8080/carrier/wallet?payment=error
SEPAY_CANCEL_URL=http://localhost:8080/carrier/wallet?payment=cancel
